@echo off
REM ===========================================================================
REM  Crush - remove stale build artefacts
REM
REM  Deletes only leftovers from earlier builds. It does NOT touch the app,
REM  the engine, the priors, the benchmarks, or your "Claude outputs" folder.
REM
REM  Safe to run more than once; anything already gone is skipped.
REM ===========================================================================
setlocal EnableDelayedExpansion
cd /d "%~dp0"
title Crush cleanup

REM --- refuse to run anywhere that is not a Crush folder ---------------------
if not exist "app.py" goto wrongplace
if not exist "engine\crush_engine.py" goto wrongplace

echo.
echo   Crush cleanup
echo   ---------------------------------------------------------------
echo.
echo   This will delete the following stale items from:
echo   %CD%
echo.

set FOUND=0
if exist "dist"              (echo     dist\                  ^(old Crush.exe, built before the launch fixes^)  & set FOUND=1)
if exist "build"            (echo     build\                 ^(PyInstaller intermediates^)                     & set FOUND=1)
if exist "Crush.spec"       (echo     Crush.spec             ^(regenerated by Build-Crush-exe.bat^)            & set FOUND=1)
if exist ".deps-ok"         (echo     .deps-ok               ^(no longer used by the new launcher^)            & set FOUND=1)
if exist "engine\__pycache__" (echo     engine\__pycache__\    ^(stale compiled caches^)                        & set FOUND=1)
if exist "ui\__pycache__"     (echo     ui\__pycache__\        ^(stale compiled caches^)                        & set FOUND=1)
if exist "__pycache__"        (echo     __pycache__\           ^(stale compiled caches^)                        & set FOUND=1)

if "%FOUND%"=="0" (
  echo     Nothing to clean - this folder is already tidy.
  echo.
  pause
  exit /b 0
)

echo.
echo   It will KEEP: app.py, ui\, engine\, priors\, tools\, benchmark\,
echo                 tests\, lab\, CLAUDE.md, HANDOFF.md, SECURITY.md,
echo                 README.md, BENCHMARKS.md, V4-RESULTS.md, the launchers,
echo                 crush-debug.log, and your "Claude outputs" folder.
echo.
set /p GO=  Type Y then Enter to delete these, anything else to cancel:
if /i not "%GO%"=="Y" (
  echo.
  echo   Cancelled. Nothing was deleted.
  echo.
  pause
  exit /b 0
)

echo.
if exist "dist"               (rd /s /q "dist"               2>nul & echo     removed dist\)
if exist "build"              (rd /s /q "build"              2>nul & echo     removed build\)
if exist "Crush.spec"         (del /q /f "Crush.spec"        2>nul & echo     removed Crush.spec)
if exist ".deps-ok"           (del /q /f ".deps-ok"          2>nul & echo     removed .deps-ok)
if exist "engine\__pycache__" (rd /s /q "engine\__pycache__" 2>nul & echo     removed engine\__pycache__\)
if exist "ui\__pycache__"     (rd /s /q "ui\__pycache__"     2>nul & echo     removed ui\__pycache__\)
if exist "__pycache__"        (rd /s /q "__pycache__"        2>nul & echo     removed __pycache__\)

echo.
echo   Done. About 60 MB freed.
echo.
echo   To make a fresh standalone Crush.exe, run Build-Crush-exe.bat.
echo   To just use the app, run Crush.bat.
echo.
pause
exit /b 0

:wrongplace
echo.
echo   This does not look like the Crush folder - app.py and
echo   engine\crush_engine.py are not both here, so nothing was deleted.
echo.
echo   Put Cleanup.bat in the same folder as Crush.bat and run it there.
echo.
pause
exit /b 1
