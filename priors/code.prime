#define __bcdsub(__a, __b, __ps) __builtin_ppc_bcdsub((__a), (__b), (__ps))

static __inline__ long __bcdadd_ofl(vector unsigned char __a,
                                    vector unsigned char __b) {
  return __builtin_ppc_bcdadd_p(__CR6_SO, __a, __b);
}

