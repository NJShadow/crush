    _Q6V64_internal_union.d;                                                   \
  })
#define Q6V64_PUT_H1(v, new)                                                   \
  __extension__({                                                              \
    union {                                                                    \
      long long d;                                                             \
      short h[4];                                                              \
    } _Q6V64_internal_union;                                                   \
    _Q6V64_internal_union.d = (v);                                             \
    _Q6V64_internal_union.h[1] = (new);                                        \
    _Q6V64_internal_union.d;                                                   \
  })
#define Q6V64_PUT_H2(v, new)                                                   \
  __extension__({                                                              \
    union {                                                                    \
      long long d;                                                             \
      short h[4];                                                              \
    } _Q6V64_internal_union;                                                   \
    _Q6V64_internal_union.d = (v);                                             \
    _Q6V64_internal_union.h[2] = (new);                                        \
